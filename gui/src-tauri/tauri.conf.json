{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZCode Skin Manager",
  "version": "0.1.0",
  "identifier": "com.zhongruan.zcode-skin-manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZCode皮肤管理器",
        "width": 1120,
        "height": 760,
        "minWidth": 940,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../skins": "skins/"
    },
    "windows": {
      "nsis": {
        "languages": ["English", "SimpChinese", "TradChinese"],
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  }
}
